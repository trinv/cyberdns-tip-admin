{
  "name": "cyberdns-tip",
  "private": true,
  "version": "1.0.0",
  "description": "CyberDNS TIP — Threat Intelligence & Domain Blocklist management platform (React + Express + PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && tsx server.ts",
    "build": "node scripts/copy-maplibre-worker.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/migrate.cjs && esbuild scripts/baseline-existing-db.mjs --bundle --platform=node --format=cjs --packages=external --outfile=dist/baseline.cjs",
    "start": "node dist/server.cjs",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:baseline": "node scripts/baseline-existing-db.mjs",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.8.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.7",
    "@vitejs/plugin-react": "^5.0.4"
  },
  "_overridesNote": "express 4.x pins qs 6.15.3 (last version in the qs DoS / array-limit advisory range); the override forces the patched line everywhere. Remove once express depends on qs >= 6.16.",
  "overrides": {
    "qs": "^6.16.0"
  }
}
