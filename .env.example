# CyberDNS TIP — environment configuration.
# Copy this file to .env and fill in real values, then edit .env (not this file):
#   cp .env.example .env

# ---- Server ----
NODE_ENV=production
PORT=3000

# ---- PostgreSQL password (Docker Compose path) ----
# docker-compose.yml uses this to set the `db` container's password AND to
# build the app container's DATABASE_URL automatically (postgres://cyberdns_app:<this>@db:5432/cyberdns_tip)
# — you only need to set it once, here. Pick a real password before your
# first `docker compose up`.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- PostgreSQL connection (native/non-Docker install ONLY) ----
# Ignored when running via docker-compose.yml (it constructs DATABASE_URL
# itself from POSTGRES_PASSWORD above). Set this instead if you're running
# `npm run build && npm start` directly against a PostgreSQL instance you
# manage yourself (see DEPLOY.md's "Cài đặt không dùng Docker" section).
# DATABASE_URL=postgres://cyberdns_app:CHANGE_ME@localhost:5432/cyberdns_tip

# DB_SSL: "true" or "false" to force TLS on/off. If unset, SSL defaults to
# off for a local host (localhost/127.0.0.1, or the `db` Docker Compose
# service) and on (with rejectUnauthorized:false) for any other host —
# override to "true" if pointing DATABASE_URL at a managed/remote Postgres.
DB_SSL=false

# ---- Initial Super Admin account ----
# Created automatically on first boot if no active Admin account exists yet
# (see ensureSuperAdmin in src/db/queries.ts). If left unset, a random
# password is generated and printed ONCE to the server startup log — set
# these explicitly instead for a reproducible first deploy, then change the
# password from the app's user-management screen after first login.
SUPERADMIN_EMAIL=admin@cyberdns.local
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
