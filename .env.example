# CyberDNS TIP — environment configuration.
# Copy this file to .env and fill in real values, then edit .env (not this file):
#   cp .env.example .env

# ---- Server ----
NODE_ENV=production
PORT=3000
# Interface to bind. Leave as 0.0.0.0 for Docker (the container port mapping
# needs it). For a NATIVE install behind Nginx on the same host, set
# HOST=127.0.0.1 so the app can't be reached directly from the internet.
HOST=0.0.0.0

# ---- PostgreSQL password (Docker Compose path) ----
# docker-compose.yml uses this to set the `db` container's password AND to
# build the app container's DATABASE_URL automatically (postgres://cyberdns_app:<this>@db:5432/cyberdns_tip)
# — you only need to set it once, here. Pick a real password before your
# first `docker compose up`.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- PostgreSQL connection (native/non-Docker install ONLY) ----
# Ignored when running via docker-compose.yml (it constructs DATABASE_URL
# itself from POSTGRES_PASSWORD above). Set this instead if you're running
# `npm run build && npm start` directly against a PostgreSQL instance you
# manage yourself (see DEPLOY.md's "Cài đặt không dùng Docker" section).
# DATABASE_URL=postgres://cyberdns_app:CHANGE_ME@localhost:5432/cyberdns_tip

# DB_SSL:
#   false      → no TLS (Docker Compose path: app ↔ db on the private
#                container network; also a local Postgres / Auth Proxy).
#   true       → TLS, certificate VERIFIED against the system CA store — or
#                against DB_CA_CERT below if set (RDS / Cloud SQL / your own
#                Postgres: download the provider's CA bundle and point at it).
#   no-verify  → TLS but accept any certificate (encryption only, no MITM
#                protection) — last resort for a provider whose chain won't
#                verify.
#   unset      → local host: no TLS. Any other host: TLS, verified.
DB_SSL=false
# DB_CA_CERT=/etc/ssl/certs/your-db-provider-ca.pem

# ---- Initial Super Admin account ----
# Created automatically on first boot IF this email has no account yet AND no
# other active Admin exists (see ensureSuperAdmin in src/db/queries.ts). If
# SUPERADMIN_PASSWORD is left unset (or still the placeholder below), a random
# password is generated and printed ONCE to the server startup log. Change it
# from the app's user-management screen after first login.
#
# The email is lowercased before storage — matching the login form — so any
# capitalisation here is fine.
#
# On later boots, if the account exists but is deactivated/demoted, the app
# only RESTORES its Admin role + active flag — it does NOT touch the password
# (so a password you changed in the UI survives redeploys). To also reset the
# password (e.g. you're locked out), set SUPERADMIN_FORCE_RESET=true for ONE
# boot, then remove it again.
SUPERADMIN_EMAIL=admin@cyberdns.local
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# SUPERADMIN_FORCE_RESET=true

# ---- PostgreSQL server tuning (Docker Compose path only) ----
# The stock postgres:17-alpine image's defaults are sized for a tiny
# container, not a write-heavy feed sync — the defaults below are safe on
# almost any VPS (even 1-2GB RAM) and already meaningfully better than
# leaving these unset. If your VPS has more RAM, raising PG_SHARED_BUFFERS/
# PG_EFFECTIVE_CACHE_SIZE further will help — rule of thumb: shared_buffers
# ~= 25% of the VPS's total RAM, effective_cache_size ~= 50-75%.
#
# PG_MAX_WAL_SIZE / PG_CHECKPOINT_TIMEOUT: how much WAL Postgres lets build
# up (and how long it waits) before forcing a checkpoint. This is a real
# trade-off, not a pure "higher is better" knob: raising PG_MAX_WAL_SIZE
# makes checkpoints fire LESS often, but each one has more WAL to flush, so
# on a VPS with slow disk I/O it makes each individual stall LONGER — measured
# on one VPS: doubling this from 1GB to 2GB roughly doubled a single
# checkpoint's write-phase duration (60s -> 150-220s) for the same real disk
# throughput. If you're seeing "checkpoint starting: wal" appear very
# frequently (every ~60-90s) in the Postgres log with each one's "write="
# duration reasonably short, that's an efficiency question (this default is
# already reasonable). If instead you're seeing occasional but very LONG
# stalls (write= over a minute) causing timeouts/"Connection reset by peer",
# your disk write throughput itself is the actual bottleneck — LOWERING
# this (e.g. 512MB) trades more-frequent-but-shorter stalls, which are less
# likely to individually blow through a client timeout; it does not fix the
# underlying disk speed. Trade-off either way: a crash right before a
# checkpoint replays a bit more WAL on restart — a few extra seconds of
# recovery time, not a data-loss risk (committed data is always safe in the
# WAL regardless of checkpoint timing).
PG_MAX_WAL_SIZE=1GB
PG_CHECKPOINT_TIMEOUT=15min
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# ---- Email alerts: login from a new IP ----
# Sends a warning email whenever a login succeeds from an IP address never
# seen before for that account (see recordLoginAttempt in queries.ts and
# src/lib/mailer.ts) — the same real signal that already drives the in-app
# toast warning and the Login History view's "IP mới" badge.
#
# Leave SMTP_HOST empty to disable email alerts entirely (the in-app toast
# still shows either way) — the default for local dev.
#
# Works with any standard SMTP relay:
#  - Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false. SMTP_PASSWORD must
#    be an "App Password" (myaccount.google.com/apppasswords), NOT your
#    normal Google account password — Gmail rejects that over SMTP.
#  - SendGrid/Mailgun/AWS SES/any other provider: use their SMTP relay
#    host/port/credentials the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "false" = STARTTLS on port 587 (the common case). "true" = implicit TLS on port 465.
SMTP_SECURE=false
# The From: header on outgoing alert emails. Doesn't need to match SMTP_USER
# for most providers, but does for plain Gmail SMTP.
SMTP_FROM=CyberDNS TIP <alerts@cyberdns.vn>
# Where the new-IP-login warning email is sent — can be any address, not
# necessarily the account that logged in (this is a security-alert
# recipient, e.g. a system administrator's inbox).
SECURITY_ALERT_EMAIL=

# ---- DNS Node Monitoring portal link ----
# "VITE_" prefix: baked into the client bundle at BUILD time (import.meta.env),
# not read by the Express server at runtime. Docker: it's wired through
# docker-compose.yml's build.args, so set it here THEN
# `docker compose up -d --build`. Native: set it before `npm run build`.
# Points the "DNS Map Monitoring" button on the DNS Node management screen at
# your own externally-hosted Uptime Kuma status page (this app does not run
# Uptime Kuma itself). Leave empty to show that button disabled.
VITE_UPTIME_KUMA_URL=https://uptime.cyberdns.vn
