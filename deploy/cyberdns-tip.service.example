# Reference copy of the systemd unit deploy/install-ubuntu.sh generates
# automatically at /etc/systemd/system/cyberdns-tip.service. Only needed if
# you're setting the service up by hand instead of running that script —
# replace the two placeholders below and copy it into place yourself:
#
#   sudo cp deploy/cyberdns-tip.service.example /etc/systemd/system/cyberdns-tip.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cyberdns-tip

[Unit]
Description=CyberDNS TIP
After=network.target postgresql.service

[Service]
Type=simple
User=REPLACE_WITH_YOUR_LINUX_USER
WorkingDirectory=/path/to/cyberdns-tip
EnvironmentFile=/path/to/cyberdns-tip/.env
ExecStart=/usr/bin/node /path/to/cyberdns-tip/dist/server.cjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
