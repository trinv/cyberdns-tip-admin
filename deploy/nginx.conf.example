# Reverse proxy CyberDNS TIP (listening on 127.0.0.1:3000, whether started
# via Docker Compose or the native systemd service) behind Nginx, so you can
# put a real domain + free HTTPS (Let's Encrypt) in front of it instead of
# exposing the raw app port.
#
# For tipadmin.cyberdns.vn specifically, prefer the automated script
# instead of following this file by hand — it does everything below plus
# firewall hardening: deploy/setup-domain-ssl.sh. Keep this file as a manual
# reference, or for a different domain.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/cyberdns-tip
#   # edit server_name below to your real domain first
#   sudo ln -s /etc/nginx/sites-available/cyberdns-tip /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then add HTTPS with Certbot (free, auto-renewing):
#   sudo apt-get install -y certbot python3-certbot-nginx
#   sudo certbot --nginx -d your-domain.example

server {
    listen 80;
    server_name your-domain.example;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Default (60s) can be shorter than a slow query legitimately takes
        # under heavy write load (e.g. mid-checkpoint on a VPS with slow
        # disk I/O — see .env.example's PG_MAX_WAL_SIZE) — a request that's
        # still genuinely running shouldn't get cut off and reported to the
        # user as a failure.
        proxy_read_timeout 120s;
    }
}
